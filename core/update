#!/usr/bin/env bash
#
# core/update — pull latest, rebuild, restart the Aimy desktop app.
#
# Usage:
#   ./update            pull + rebuild + relaunch (dev mode, fast)
#   ./update --dist     pull + full packaged build (dmg/AppImage); slower,
#                       run this when you want the real installer artifact
#
# Fails loudly instead of half-updating: if the pull can't fast-forward
# (local changes or divergence), it stops and tells you.
set -euo pipefail
cd "$(dirname "$0")"

DIST=0
if [[ "${1:-}" == "--dist" ]]; then
  DIST=1
fi

echo "→ pulling latest..."
if ! git pull --ff-only; then
  echo "✗ pull failed (local changes or diverged branch)."
  echo "  Stash or commit your changes, then run ./update again."
  exit 1
fi

echo "→ checking dependencies..."
if ! git diff --quiet HEAD@{1} HEAD -- package.json package-lock.json 2>/dev/null; then
  echo "  lockfile changed, reinstalling..."
  npm ci
else
  echo "  unchanged, skipping."
fi

echo "→ stopping any running Aimy..."
# Packaged app (macOS/Windows/Linux builds)
pkill -x "Aimy" 2>/dev/null || true
pkill -x "aimy" 2>/dev/null || true
# Dev-mode electron running this repo's main.js
pkill -f "dist/desktop/src/main/main.js" 2>/dev/null || true
# TTS server (detached child, survives electron — must kill explicitly)
pkill -f "tts-server.py" 2>/dev/null || true
# STT server (detached child, survives electron — must kill explicitly)
pkill -f "stt-server.py" 2>/dev/null || true
# Stale vite dev servers from previous runs (they hold port 5173)
pkill -f "vite --config desktop/vite.config.ts" 2>/dev/null || true
sleep 1
# Wait for port 5173 to actually free up before starting a new vite
for _ in $(seq 1 15); do
  if ! curl -sf -o /dev/null http://127.0.0.1:5173 2>/dev/null; then
    break
  fi
  sleep 1
done

if [[ "$DIST" == "1" ]]; then
  echo "→ building packaged app (this takes a few minutes)..."
  npm run dist
  echo "✓ done — installer is in desktop/release/"
  echo "  Install it, then launch Aimy from your Applications folder."
  exit 0
fi

echo "→ clearing caches..."
# Vite cache
rm -rf node_modules/.vite 2>/dev/null || true
# Electron cache (keeps login data, clears code cache)
rm -rf ~/Library/Application\ Support/Aimy/Cache 2>/dev/null || true
rm -rf ~/Library/Application\ Support/Aimy/Code\ Cache 2>/dev/null || true

# Generate version badge (git short hash + timestamp)
VERSION=$(git rev-parse --short HEAD 2>/dev/null || echo "dev")
BUILDTIME=$(date +%H:%M)
VERSION_STR="$VERSION@$BUILDTIME"
echo "window.AIMY_VERSION = \"$VERSION_STR\";" > desktop/src/renderer/version.js
echo "  version: $VERSION_STR"

echo "→ rebuilding..."
# Log build output for debugging
BUILD_LOG="/tmp/aimy-build.log"
npm run build 2>&1 | tee "$BUILD_LOG"
BUILD_STATUS=${PIPESTATUS[0]}
TIMESTAMP=$(date "+%Y-%m-%d %H:%M %Z")
if [[ $BUILD_STATUS -ne 0 ]]; then
  echo "✗ build failed — see $BUILD_LOG"
  # Log the failure to the changelog
  {
    echo ""
    echo "---"
    echo ""
    echo "## $TIMESTAMP — $VERSION_STR"
    echo ""
    echo "**Status:** Build FAILED."
    echo ""
    echo "See \`/tmp/aimy-build.log\` for errors."
  } >> CHANGELOG.md
  exit $BUILD_STATUS
fi
npm run desktop:assets
npm run desktop:preload
# Ensure version.txt is in the built renderer
cp desktop/src/renderer/version.txt dist/desktop/src/renderer/version.txt 2>/dev/null || true

echo "→ starting vite dev server..."
# Both are log-redirected so the terminal stays usable.
npx vite --config desktop/vite.config.ts >/tmp/aimy-vite.log 2>&1 &
VITE_PID=$!

echo "→ waiting for vite (http://127.0.0.1:5173)..."
READY=0
for _ in $(seq 1 60); do
  if curl -sf -o /dev/null http://127.0.0.1:5173 2>/dev/null; then
    READY=1
    break
  fi
  sleep 1
done
if [[ "$READY" != "1" ]]; then
  echo "✗ vite dev server did not come up within 60s."
  echo "  Check /tmp/aimy-vite.log (vite pid $VITE_PID)"
  exit 1
fi

echo "→ signing Electron for LAN access (ad-hoc + network.client entitlement)..."
# macOS blocks LAN access for ad-hoc signed binaries without the network.client
# entitlement. Re-sign the dev Electron on every build so OMA (192.168.1.x) is reachable.
ENTITLEMENTS_PLIST="/tmp/aimy-entitlements.plist"
cat > "$ENTITLEMENTS_PLIST" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
EOF
ELECTRON_APP="node_modules/electron/dist/Electron.app"
if [[ -d "$ELECTRON_APP" ]]; then
  codesign --force --deep --sign - --entitlements "$ENTITLEMENTS_PLIST" "$ELECTRON_APP" 2>/dev/null || echo "  (codesign failed, continuing anyway)"
  echo "  signed."
else
  echo "  (Electron.app not found, skipping)"
fi

echo "→ launching electron..."
AIMY_DEV=1 npx electron dist/desktop/src/main/main.js >/tmp/aimy-electron.log 2>&1 &
ELECTRON_PID=$!
echo "✓ Aimy restarted (dev mode). vite pid $VITE_PID, electron pid $ELECTRON_PID"
echo "  Logs: /tmp/aimy-vite.log /tmp/aimy-electron.log"

echo "→ checking startup hooks..."
# Wait for hooks to run (they execute during app boot, before engine starts).
# Poll the electron log for [hooks] completion lines, up to 15s.
HOOKS_DONE=0
for _ in $(seq 1 15); do
  if grep -q "\[hooks\] running .* startup hook" /tmp/aimy-electron.log 2>/dev/null; then
    # Hooks started; wait for them to finish (no more "running" without "completed"/"exited")
    sleep 2
    HOOKS_DONE=1
    break
  fi
  sleep 1
done
if [[ "$HOOKS_DONE" == "1" ]]; then
  # Display hook results with color-coded status:
  # green = success, yellow = hook failed (non-blocking, warning), red = spawn/timeout error
  GREEN='\033[0;32m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; NC='\033[0m'
  grep "\[hooks\]" /tmp/aimy-electron.log | while IFS= read -r line; do
    if echo "$line" | grep -q "completed"; then
      name=$(echo "$line" | sed 's/.*\[hooks\] //; s/ completed//')
      printf "  ${GREEN}✓ %s${NC}\n" "$name"
    elif echo "$line" | grep -qE "\[hooks\] [^:]+: "; then
      # Hook detail output (e.g. "10-oma-tunnel.sh: LLM tunnel (8080): already up")
      detail=$(echo "$line" | sed 's/.*\[hooks\] //')
      printf "    ${NC}%s${NC}\n" "$detail"
    elif echo "$line" | grep -q "exited with code"; then
      name=$(echo "$line" | sed 's/.*\[hooks\] //; s/ exited with code.*//')
      code=$(echo "$line" | sed 's/.*exited with code //')
      # Non-zero exit = hook failed but didn't block boot → yellow (warning)
      printf "  ${YELLOW}! %s (exit %s)${NC}\n" "$name" "$code"
    elif echo "$line" | grep -q "failed to spawn"; then
      name=$(echo "$line" | sed 's/.*\[hooks\] //; s/ failed to spawn.*//')
      printf "  ${RED}✗ %s (failed to spawn)${NC}\n" "$name"
    elif echo "$line" | grep -q "no startup hooks found"; then
      echo "  (no startup hooks)"
    fi
  done
else
  YELLOW='\033[0;33m'; NC='\033[0m'
  printf "  ${YELLOW}(hooks not yet run — check /tmp/aimy-electron.log)${NC}\n"
fi

# Log the successful build to the changelog
{
  echo ""
  echo "---"
  echo ""
  echo "## $TIMESTAMP — $VERSION_STR"
  echo ""
  echo "**Status:** Build succeeded, app restarted."
  echo ""
  echo "_(Zen: add what changed in this batch above this line.)_"
} >> CHANGELOG.md
